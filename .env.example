# ===========================================
# CoverAI Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# For production, set these in your hosting platform's environment variables.

# -------------------------------------------
# Database (Supabase / Railway / Local)
# -------------------------------------------
# Supabase pooler: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/coverai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coverai

# -------------------------------------------
# Redis (Upstash / Local)
# -------------------------------------------
# Upstash: rediss://default:[PASSWORD]@[HOST]:6379
# Local Docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# AI Services
# -------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------
# Security
# -------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_64_char_hex_secret_eg_openssl_rand_hex_32

# -------------------------------------------
# CORS
# -------------------------------------------
# Comma-separated list of origins, e.g. http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# -------------------------------------------
# Storage
# -------------------------------------------
STORAGE_BUCKET=coverai-documents-bucket
STORAGE_BACKEND=local

# -------------------------------------------
# Google OAuth (optional)
# -------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# -------------------------------------------
# Encryption (DPDP)
# -------------------------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your_fernet_key_here

# -------------------------------------------
# Frontend (Vercel)
# -------------------------------------------
# Set in Vercel dashboard as NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api/v1
