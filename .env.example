# Database
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/coverai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/coverai

# Redis
# For local Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Security
JWT_SECRET=generate_a_64_char_hex_secret_eg_openssl_rand_hex_32

# CORS
# Comma-separated list of origins, e.g. http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000

# Storage
STORAGE_BUCKET=coverai-documents-bucket
