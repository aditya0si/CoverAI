{
  "name": "coverai-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npx playwright test",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.js",
    "test:e2e:customer": "npx playwright test --project=customer",
    "test:e2e:insurer": "npx playwright test --project=insurer",
    "test:e2e:advisor": "npx playwright test --project=advisor",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "turbo": "^2.0.4"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.12",
      "glob@10": "10.5.0",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.23",
      "postcss-selector-parser@6": "6.1.3",
      "form-data@4": "4.0.6",
      "source-map-js@1": "1.2.2",
      "sharp@0": "0.35.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
