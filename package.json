{
  "name": "coverai-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npx playwright test",
    "test:e2e:customer": "npx playwright test --project=customer",
    "test:e2e:insurer": "npx playwright test --project=insurer",
    "test:e2e:advisor": "npx playwright test --project=advisor",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "turbo": "^2.0.4"
  },
  "packageManager": "pnpm@9.1.4"
}
